# n8n env — copy to n8n.env. n8n stores its actual workflow + credential
# state in the n8n-data named volume, not here. These are bootstrap
# settings for the first run.
#
# Routing-related vars (N8N_AGENT_MAP, N8N_IMPLEMENTER_DEFAULT, etc.)
# are GONE in the manager-mediated model. The dispatcher inside the
# manager-agent container reads /etc/onym/employees.json directly.
# n8n itself doesn't know which employees exist — it only knows about
# one downstream SSH target: manager-agent.

# Encrypt n8n's credentials-at-rest. Generate once:
#   openssl rand -hex 32
# If you ever change this after creating credentials, you lose access to
# them — keep it somewhere safe.
N8N_ENCRYPTION_KEY=REPLACE_ME

# Timezone for cron nodes.
GENERIC_TIMEZONE=UTC

# Basic auth on the n8n UI. Even though 5678 is loopback-bound and
# reached via Caddy at https://, belt + suspenders.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=REPLACE_ME

# Public hostname for n8n. Caddy terminates TLS at this hostname and
# reverse-proxies to n8n internally. Must match N8N_PUBLIC_HOST in
# caddy.env and the host portion of WEBHOOK_URL below.
N8N_HOST=n8n.example.com

# Public webhook URL — must be https://<N8N_HOST>/. The org-level GitHub
# webhook will POST to <WEBHOOK_URL>webhook/<path> for each workflow,
# arriving at Caddy on 443 and proxied to n8n on the orchestration net.
WEBHOOK_URL=https://n8n.example.com/

# Don't write telemetry pings.
N8N_DIAGNOSTICS_ENABLED=false

# Let IF / Code nodes read $env.* in expressions. Workflow filters need
# N8N_ALLOWED_ORG visible inside the evaluator. n8n defaults this to
# block — we flip it.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# -- Authorization -----------------------------------------------------------
# GitHub organization whose members are allowed to invoke the agent
# workflows. Workflows that humans can trigger (mention / comment / slash)
# do an HTTP check against `GET /orgs/<org>/members/<sender.login>`
# (204 = member, 404 = not) using the `manager GitHub` credential. The
# manager bot PAT therefore needs `read:org` plus a member of <org>.
N8N_ALLOWED_ORG=onymchat

# Comma-separated list of bot logins that count as "an agent" for the
# mention-triggered workflows (07–12). The trigger only fires when the
# inbound text @-mentions one of these logins; an @-mention of a human
# teammate (or a third party in another repo's thread) is ignored. Must
# include the manager's githubLogin and every employee's githubLogin
# from employees.json. Case-insensitive.
N8N_AGENT_LOGINS=lead-onym,dev-onym,ux-onym
