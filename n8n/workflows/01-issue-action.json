{
  "name": "01 Issue action",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "qa-issue",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "qa-issue"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "b1000000-0000-0000-0000-000000000001",
              "leftValue": "={{ (() => { const b = $json.body; if (!['opened','reopened','labeled','assigned'].includes(b.action)) return false; if (!b.issue || b.issue.pull_request) return false; if (b.sender && b.sender.type === 'Bot') return false; const labels = (b.issue.labels || []).map(l => l.name); const hasLabel = labels.includes('agent-task'); const hasAssignee = (b.issue.assignees || []).length > 0; return hasLabel || hasAssignee; })() }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000002",
      "name": "Is candidate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const b = $('Webhook').item.json.body;\nconst issue = b.issue;\nconst body = issue.body || '';\nconst assignees = (issue.assignees || []).map(a => a.login);\nconst args = {\n  surface: 'issue-action',\n  repoOwner: b.repository.owner.login,\n  repoName: b.repository.name,\n  repoFull: b.repository.full_name,\n  senderLogin: b.sender && b.sender.login,\n  senderType: b.sender && b.sender.type,\n  issueNumber: issue.number,\n  issueTitle: issue.title,\n  issueBody: body,\n  issueUrl: issue.html_url,\n  assigneeLogin: assignees[0] || '',\n  reviewerLogin: '',\n  title: issue.title,\n  bodyText: body,\n};\nconst prompt = `Issue #${args.issueNumber}: ${args.issueTitle}\n\n${args.issueBody}\n\nImplement a fix. Keep the change minimal and focused on the reported problem. Commit with a clear message and exit when done.\n`;\nargs.promptB64 = Buffer.from(prompt, 'utf8').toString('base64');\nreturn [{ json: { argsB64: Buffer.from(JSON.stringify(args), 'utf8').toString('base64') } }];\n"
      },
      "id": "a1000000-0000-0000-0000-000000000003",
      "name": "Build args",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "authentication": "privateKey",
        "resource": "command",
        "command": "=exec n8n-manager-dispatch \"{{ $json.argsB64 }}\"\n"
      },
      "id": "a1000000-0000-0000-0000-000000000004",
      "name": "Dispatch via manager",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [900, 300],
      "credentials": { "sshPrivateKey": { "id": "REPLACE_ME", "name": "manager-agent SSH" } }
    },
    {
      "parameters": {
        "jsCode": "const stdout = $json.stdout || '';\nconst pick = (key) => { const m = stdout.match(new RegExp('^' + key + '=(.*)$', 'm')); return m ? m[1].trim() : ''; };\nreturn [{ json: { stdout, prUrl: pick('PR_URL'), skipped: pick('SKIPPED'), routeTarget: pick('ROUTE_TARGET') } }];\n"
      },
      "id": "a1000000-0000-0000-0000-000000000005",
      "name": "Parse result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "b1000000-0000-0000-0000-000000000030",
              "leftValue": "={{ $json.prUrl }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEquals" }
            },
            {
              "id": "b1000000-0000-0000-0000-000000000031",
              "leftValue": "={{ $json.skipped }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000006",
      "name": "Has new PR?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/{{ $('Webhook').item.json.body.repository.full_name }}/issues/{{ $('Webhook').item.json.body.issue.number }}/comments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"body\": \"@{{ $json.routeTarget }} opened {{ $json.prUrl }} for this issue.\"\n}",
        "options": { "response": { "response": { "fullResponse": true, "neverError": true } } }
      },
      "id": "a1000000-0000-0000-0000-000000000007",
      "name": "Comment on issue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 300],
      "credentials": { "githubApi": { "id": "REPLACE_ME", "name": "manager GitHub" } }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Is candidate?", "type": "main", "index": 0 }]] },
    "Is candidate?": { "main": [[{ "node": "Build args", "type": "main", "index": 0 }], []] },
    "Build args": { "main": [[{ "node": "Dispatch via manager", "type": "main", "index": 0 }]] },
    "Dispatch via manager": { "main": [[{ "node": "Parse result", "type": "main", "index": 0 }]] },
    "Parse result": { "main": [[{ "node": "Has new PR?", "type": "main", "index": 0 }]] },
    "Has new PR?": { "main": [[{ "node": "Comment on issue", "type": "main", "index": 0 }], []] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": []
}
